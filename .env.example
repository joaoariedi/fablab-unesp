# Copy to .env and adjust. Every variable apps/web reads is listed here (FR-024).
# The defaults match infra/docker-compose.yml, so a clean clone works unchanged.
#
# Never commit a real .env — .gitignore excludes it and CI runs gitleaks on every PR.

# --- required ---------------------------------------------------------------------------

# Postgres. Shape: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URI=postgres://fablab:fablab@localhost:5432/fablab

# Signs auth tokens. Changing it invalidates every existing session.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- host ports (only if something already uses the defaults) ----------------------------
#
# A machine with a local Postgres on 5432 fails `docker compose up` with "port is already
# allocated", which reads as a broken quick start. Move the host port here and remember to
# update DATABASE_URI to match.

# DB_PORT=55432
# S3_PORT=9000
# S3_CONSOLE_PORT=9001

# --- dev-only master bootstrap (CLR-003) -------------------------------------------------
#
# The seed creates a master account from these ONLY when NODE_ENV is not 'production'.
# Production deliberately ships no credential in configuration: the first master is created
# through Payload's create-first-user screen at /admin. Leaving these set in production is
# ignored by the seed, not honoured.

SEED_MASTER_EMAIL=master@fablab.local
SEED_MASTER_PASSWORD=change-me-in-dev-only

# --- object storage (declared now, consumed by feature 002) ------------------------------
#
# Swapping MinIO for S3/R2 is an edit to these five lines and nothing else (FR-006, SC-008).

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fablab
S3_ACCESS_KEY_ID=fablab
S3_SECRET_ACCESS_KEY=fablab-dev-secret
S3_REGION=us-east-1
