# SquareFont left the project on 2026-08-27 (designer replaced it with Aldo the Apache).
# These entries STAY, with the reason inverted: they no longer stage a local setup, they
# stop an accidental commit of a binary whose own metadata says "Typeface © Bou Fonts.
# 2011. All Rights Reserved" into a public MIT repo. An earlier README told developers to
# put Square.ttf in that folder, so working trees out there still have it.
# Aldo the Apache IS tracked; it carries no such claim (docs/product/fonts/).
docs/product/fonts/Square.ttf
docs/product/fonts/Squareo.ttf

# --- workspace (feature 000) ---
node_modules/
.pnpm-store/

# Next.js
.next/
next-env.d.ts
out/

# build output
dist/
*.tsbuildinfo

# environment — never commit real values; .env.example is the contract
.env
.env.*
!.env.example

# test / coverage
coverage/

# Payload generated types (regenerated from the config)
apps/web/payload-types.ts

# The speckit plan-phase marker. Transient by design: `speckit.plan` creates it in pre-flight
# and clears it after plan.md is written, and while it exists a PreToolUse hook blocks every
# Write/Edit outside .specify/.
#
# It must never be committed. On 2026-09-07 a `git add -A` swept it into a commit, so it
# survived the plan phase and silently blocked the NEXT workflow run — one task could not write
# a single file and reported as failed, while agents using shell heredocs wrote normally, which
# made the block look like a flaky task rather than a repo-wide switch. Two contributing causes,
# both worth knowing: the helper's `plan-phase-end` does `rm -f` on a RELATIVE path and always
# prints "cleared", so run from a subdirectory it removes nothing and still reports success; and
# a tracked marker comes back on any checkout even when correctly deleted.
.specify/.plan-in-progress
